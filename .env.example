# Datenbank. Im Compose-Verbund zeigt der Host auf den Dienst "db".
DATABASE_URL=postgres://schiriplan:schiriplan@localhost:5432/schiriplan

# Passwort der Datenbank im Compose-Verbund. Ohne diese Angabe startet der
# Verbund gar nicht — einen Standardwert gibt es bewusst nicht, denn er stuende
# hier und waere damit oeffentlich bekannt. In den DATABASE_URL oben gehoert
# derselbe Wert. Erzeugen: openssl rand -base64 24
POSTGRES_PASSWORD=

# Schluessel fuer Sitzungscookies und Login-Token. In Produktion zwingend
# ersetzen: openssl rand -base64 48
SESSION_SECRET=bitte-ersetzen

# Anmeldung ueber einen Link statt ueber ein Passwort. Standard "aus": jeder
# Link verbraucht eine WhatsApp-Nachricht, und davon gibt es nur 2000 im Monat.
# Auf "an" stellen, sobald das Budget steht — der Weg ist vollstaendig gebaut.
LOGIN_MAGIC_LINK=aus

# Nachrichtenversand.
#   dev       Nichts geht hinaus. Alles steht unter /dev/outbox.
#   email     Uebergangskanal ueber SMTP_URL.
#   whatsapp  Meta Cloud API.
NOTIFICATION_CHANNEL=dev

# Meta WhatsApp Cloud API. Nur noetig, wenn NOTIFICATION_CHANNEL=whatsapp.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# E-Mail als Test- und Uebergangskanal.
SMTP_URL=
MAIL_FROM=schiriplan@example.org

# Oeffentliche Adresse der Anwendung. Steckt im Anmeldelink und in jeder
# Weiterleitung — im Echtbetrieb zwingend, sonst zeigen beide auf localhost.
PUBLIC_BASE_URL=http://localhost:3000

# Lenkt im E-Mail-Kanal alle Nachrichten auf ein Postfach um (Erprobung).
MAIL_TEST_RECIPIENT=

# Schuetzt den Cron-Endpunkt, der Erinnerungen und Fristen abarbeitet.
# Solange hier der Beispielwert steht, weist der Endpunkt jede Anfrage ab —
# ein offener Zeitgeber hiesse, dass jeder Fremde Nachrichten ausloesen kann.
# In Produktion zwingend ersetzen: openssl rand -base64 32
CRON_SECRET=bitte-ersetzen

# CloudBeaver, die Datenbank im Browser (Port 18978). Nur im lokalen Netz,
# nie ueber den Tunnel.
# Adresse, auf der der Port lauscht. Leer heisst 127.0.0.1 — nur der Rechner
# selbst. Fuers lokale Netz die LAN-Adresse des Servers eintragen, niemals
# 0.0.0.0: Docker oeffnet den Port an ufw vorbei.
CLOUDBEAVER_ADRESSE=
# Verwalter, der beim ersten Start angelegt wird. Ohne Passwort startet der
# Verbund nicht. Erzeugen: openssl rand -base64 18
CLOUDBEAVER_ADMIN=verwalter
CLOUDBEAVER_PASSWORT=
