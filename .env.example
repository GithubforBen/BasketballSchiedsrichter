# Datenbank. Im Compose-Verbund zeigt der Host auf den Dienst "db".
DATABASE_URL=postgres://schiriplan:schiriplan@localhost:5432/schiriplan

# Schluessel fuer Sitzungscookies und Login-Token. In Produktion zwingend
# ersetzen: openssl rand -base64 48
SESSION_SECRET=bitte-ersetzen

# Nachrichtenversand.
#   dev       Nichts geht hinaus. Alles steht unter /dev/outbox.
#   email     Uebergangskanal ueber SMTP_URL.
#   whatsapp  Meta Cloud API.
NOTIFICATION_CHANNEL=dev

# Meta WhatsApp Cloud API. Nur noetig, wenn NOTIFICATION_CHANNEL=whatsapp.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# E-Mail als Test- und Uebergangskanal.
SMTP_URL=
MAIL_FROM=schiriplan@example.org

# Oeffentliche Adresse der Anwendung. Steckt im Anmeldelink und in jeder
# Weiterleitung — im Echtbetrieb zwingend, sonst zeigen beide auf localhost.
PUBLIC_BASE_URL=http://localhost:3000

# Lenkt im E-Mail-Kanal alle Nachrichten auf ein Postfach um (Erprobung).
MAIL_TEST_RECIPIENT=

# Schuetzt den Cron-Endpunkt, der Erinnerungen und Fristen abarbeitet.
# Solange hier der Beispielwert steht, weist der Endpunkt jede Anfrage ab —
# ein offener Zeitgeber hiesse, dass jeder Fremde Nachrichten ausloesen kann.
# In Produktion zwingend ersetzen: openssl rand -base64 32
CRON_SECRET=bitte-ersetzen
