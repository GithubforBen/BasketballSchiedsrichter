# Datenbank. Im Compose-Verbund zeigt der Host auf den Dienst "db".
DATABASE_URL=postgres://schiriplan:schiriplan@localhost:5432/schiriplan

# Schluessel fuer Sitzungscookies und Login-Token. In Produktion zwingend
# ersetzen: openssl rand -base64 48
SESSION_SECRET=bitte-ersetzen

# Nachrichtenversand. "dev" schreibt in die Outbox, ohne etwas zu verschicken.
# Umschalten auf "email" oder "whatsapp", sobald der Kanal steht (M5).
NOTIFICATION_CHANNEL=dev

# Meta WhatsApp Cloud API — erst ab M5 noetig.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# E-Mail als Test- und Uebergangskanal.
SMTP_URL=
MAIL_FROM=schiriplan@example.org

# Oeffentliche Basis-URL, wird fuer die Login-Links gebraucht.
PUBLIC_BASE_URL=http://localhost:3000

# Schuetzt den Cron-Endpunkt, der Erinnerungen und Fristen abarbeitet.
CRON_SECRET=bitte-ersetzen
